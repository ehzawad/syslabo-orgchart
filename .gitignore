# The supplied masters live in task-materials/ and ARE committed, so a clone
# reproduces the whole pipeline. They are Syslabo's personnel data, which is why
# this repository is private and must stay private.

# Local database. Regenerated by `migrate` + `import_excel`, so it is build
# output rather than source, and it should not travel with the code.
*.sqlite3
*.sqlite3-shm
*.sqlite3-wal

# Environment and build
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
staticfiles/

# Tooling caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Secrets and local configuration
.env
.env.*

# Editor and OS
.idea/
.vscode/
*.swp
.DS_Store

# Logs and scratch output
*.log
